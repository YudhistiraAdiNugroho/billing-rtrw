<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Donasi & Dukungan Pengembangan | <%= settings.company_header || 'Billing RTRW & RADIUS' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="icon" href="/img/logo.png">
  <style>
    :root {
      --bg-dark: #0b1120;
      --card-bg: rgba(30, 41, 59, 0.85);
      --border-color: rgba(148, 163, 184, 0.18);
      --primary: #6366f1;
      --primary-hover: #4f46e5;
      --accent: #f59e0b;
      --accent-glow: rgba(245, 158, 11, 0.25);
    }
    body {
      background: radial-gradient(1200px 600px at 15% 0%, rgba(99, 102, 241, 0.25) 0%, transparent 60%),
                  radial-gradient(900px 500px at 85% 10%, rgba(245, 158, 11, 0.18) 0%, transparent 55%),
                  radial-gradient(800px 400px at 50% 90%, rgba(16, 185, 129, 0.12) 0%, transparent 50%),
                  var(--bg-dark);
      color: #f1f5f9;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 0;
      margin: 0;
    }
    .donate-container {
      max-width: 820px;
      width: 100%;
      margin: 30px auto;
      padding: 0 16px;
    }
    .donate-card {
      background: var(--card-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--border-color);
      border-radius: 24px;
      box-shadow: 0 25px 60px -12px rgba(0, 0, 0, 0.6);
      overflow: hidden;
    }
    .donate-header {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.25) 0%, rgba(245, 158, 11, 0.18) 100%);
      padding: 30px 24px 24px;
      border-bottom: 1px solid var(--border-color);
      text-align: center;
      position: relative;
    }
    .heart-icon-badge {
      width: 56px;
      height: 56px;
      background: linear-gradient(135deg, #ec4899, #f43f5e);
      border-radius: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      color: #fff;
      box-shadow: 0 10px 25px rgba(244, 63, 94, 0.4);
      margin-bottom: 14px;
      animation: pulse-heart 2s infinite ease-in-out;
    }
    @keyframes pulse-heart {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.08); }
    }
    .donate-body {
      padding: 28px 24px;
    }
    .preset-btn {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(148, 163, 184, 0.2);
      border-radius: 14px;
      color: #e2e8f0;
      padding: 12px 14px;
      font-weight: 700;
      font-size: 14px;
      transition: all 0.2s ease;
      cursor: pointer;
      text-align: center;
      width: 100%;
    }
    .preset-btn:hover {
      background: rgba(99, 102, 241, 0.2);
      border-color: rgba(99, 102, 241, 0.4);
      color: #fff;
      transform: translateY(-2px);
    }
    .preset-btn.active {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      border-color: #818cf8;
      color: #ffffff;
      box-shadow: 0 8px 20px rgba(99, 102, 241, 0.35);
    }
    .form-control-custom {
      background: rgba(15, 23, 42, 0.7);
      border: 1px solid rgba(148, 163, 184, 0.25);
      border-radius: 14px;
      color: #fff;
      padding: 12px 16px;
      font-size: 15px;
    }
    .form-control-custom:focus {
      background: rgba(15, 23, 42, 0.9);
      border-color: #818cf8;
      color: #fff;
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
    }
    .form-control-custom::placeholder {
      color: #64748b;
    }
    .qr-container {
      background: #ffffff;
      padding: 14px;
      border-radius: 20px;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
      display: inline-block;
      max-width: 320px;
      width: 100%;
    }
    .qr-container img {
      width: 100%;
      height: auto;
      border-radius: 12px;
      display: block;
    }
    .btn-action-primary {
      background: linear-gradient(135deg, #6366f1 0%, #3b82f6 100%);
      border: none;
      color: #fff;
      font-weight: 700;
      padding: 14px 24px;
      border-radius: 14px;
      box-shadow: 0 10px 25px rgba(99, 102, 241, 0.35);
      transition: all 0.2s ease;
      width: 100%;
      font-size: 16px;
    }
    .btn-action-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 30px rgba(99, 102, 241, 0.45);
      color: #fff;
    }
    .btn-action-success {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      border: none;
      color: #fff;
      font-weight: 700;
      padding: 14px 24px;
      border-radius: 14px;
      box-shadow: 0 10px 25px rgba(16, 185, 129, 0.35);
      transition: all 0.2s ease;
      width: 100%;
      font-size: 16px;
    }
    .btn-action-success:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 30px rgba(16, 185, 129, 0.45);
      color: #fff;
    }
    .pill-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 700;
    }
    .activation-card {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.12) 0%, rgba(217, 119, 6, 0.08) 100%);
      border: 1px dashed rgba(245, 158, 11, 0.35);
      border-radius: 18px;
      padding: 18px;
      margin-top: 20px;
    }
    .code-box {
      background: #0f172a;
      border: 2px dashed #f59e0b;
      border-radius: 14px;
      padding: 12px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin: 12px 0;
    }
    .code-text {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 22px;
      font-weight: 900;
      color: #fbbf24;
      letter-spacing: 2px;
    }
    .footer-text {
      text-align: center;
      padding: 20px;
      color: #64748b;
      font-size: 13px;
    }
    .step-item {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 12px;
      font-size: 13px;
      color: #cbd5e1;
    }
    .step-num {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: rgba(99, 102, 241, 0.2);
      color: #818cf8;
      font-weight: 800;
      display: grid;
      place-items: center;
      flex-shrink: 0;
      font-size: 12px;
    }
  </style>
</head>
<body>

  <div class="donate-container">
    <div class="donate-card">
      <!-- HEADER -->
      <div class="donate-header">
        <div class="heart-icon-badge">
          <i class="bi bi-heart-fill"></i>
        </div>
        <h3 class="fw-bold mb-1" style="color:#f8fafc">Donasi & Dukungan Aplikasi</h3>
        <p class="mb-0 text-muted small" style="color:#94a3b8 !important">
          <%= settings.company_header || 'Billing RTRW & RADIUS System' %> • Dukung Pengembangan & Update Fitur
        </p>
      </div>

      <!-- BODY -->
      <div class="donate-body">
        <div class="row g-4">
          <!-- FORM INPUT KIRI -->
          <div class="col-lg-6">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
              <i class="bi bi-wallet2 text-primary"></i> 1. Masukkan Detail Donasi
            </h5>

            <!-- Preset Nominal Buttons -->
            <label class="form-label small fw-bold" style="color: #cbd5e1;">Pilih Nominal Cepat (Rp):</label>
            <div class="row g-2 mb-3">
              <div class="col-4">
                <button type="button" class="preset-btn" onclick="selectPreset(10000)">10.000</button>
              </div>
              <div class="col-4">
                <button type="button" class="preset-btn" onclick="selectPreset(25000)">25.000</button>
              </div>
              <div class="col-4">
                <button type="button" class="preset-btn active" onclick="selectPreset(50000)">50.000</button>
              </div>
              <div class="col-4">
                <button type="button" class="preset-btn" onclick="selectPreset(100000)">100.000</button>
              </div>
              <div class="col-4">
                <button type="button" class="preset-btn" onclick="selectPreset(250000)">250.000</button>
              </div>
              <div class="col-4">
                <button type="button" class="preset-btn" onclick="selectPreset(500000)">500.000</button>
              </div>
            </div>

            <!-- Custom Amount Input -->
            <div class="mb-3">
              <label class="form-label small fw-bold" style="color: #cbd5e1;">Nominal Kustom (Rp) *</label>
              <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-light fw-bold">Rp</span>
                <input type="number" id="inputAmount" class="form-control form-control-custom" min="1000" step="1000" value="50000" placeholder="50000" required oninput="onAmountChange()">
              </div>
              <div class="form-text small" style="color: #94a3b8;">Minimal donasi Rp 1.000</div>
            </div>

            <!-- Donor Name -->
            <div class="mb-3">
              <label class="form-label small fw-bold" style="color: #cbd5e1;">Nama Donatur / Sahabat (Opsional)</label>
              <input type="text" id="inputName" class="form-control form-control-custom" placeholder="Hamba Allah / Nama Anda" value="Hamba Allah">
            </div>

            <!-- Donor WhatsApp -->
            <div class="mb-3">
              <label class="form-label small fw-bold" style="color: #cbd5e1;">Nomor WhatsApp * (Untuk Kirim Kode Aktivasi)</label>
              <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-success"><i class="bi bi-whatsapp"></i></span>
                <input type="tel" id="inputPhone" class="form-control form-control-custom" placeholder="Contoh: 081234567890" required>
              </div>
              <div class="form-text small" style="color: #94a3b8;">Notifikasi ucapan terima kasih & kode aktivasi sidebar akan otomatis dikirim ke nomor ini.</div>
            </div>

            <!-- Notes / Prayer -->
            <div class="mb-3">
              <label class="form-label small fw-bold" style="color: #cbd5e1;">Pesan / Doa Dukungan (Opsional)</label>
              <textarea id="inputNotes" class="form-control form-control-custom" rows="2" placeholder="Semoga aplikasinya berkah dan semakin maju..."></textarea>
            </div>

            <!-- Button Generate / Refresh QR -->
            <button type="button" class="btn btn-action-primary" onclick="generateQris()">
              <i class="bi bi-qr-code-scan me-1"></i> Tampilkan QRIS Donasi
            </button>
          </div>

          <!-- QRIS DISPLAY & KONFIRMASI KANAN -->
          <div class="col-lg-6">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
              <i class="bi bi-qr-code text-warning"></i> 2. Scan QRIS Pembayaran
            </h5>

            <div class="text-center p-3 rounded-4" style="background: rgba(15, 23, 42, 0.65); border: 1px solid var(--border-color);">
              <div class="qr-container mb-3">
                <img id="qrImage" src="/qris/static.jpg?amount=50000" alt="QRIS Donasi" onerror="handleQrError()">
              </div>

              <div class="mb-3">
                <div class="small mb-1" style="color: #cbd5e1;">Total Nominal Transfer (Beserta Kode Unik)</div>
                <h3 class="fw-bold text-success mb-1" id="displayAmount">Rp 50.000</h3>
                <div id="uniqueBadgeContainer" class="mb-2" style="display: none;">
                  <span class="badge bg-warning text-dark fw-bold px-2 py-1" id="uniqueBadge">Termasuk Kode Unik</span>
                </div>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                  <button type="button" class="btn btn-outline-light btn-sm rounded-pill px-3" onclick="copyNominal()">
                    <i class="bi bi-clipboard me-1"></i> Salin Nominal
                  </button>
                  <button type="button" class="btn btn-outline-light btn-sm rounded-pill px-3" onclick="downloadQr()">
                    <i class="bi bi-download me-1"></i> Download QR
                  </button>
                </div>
              </div>

              <!-- LIVE PAYMENT DETECTION STATUS -->
              <div id="paymentStatusBox" class="p-2 px-3 rounded-3 small mb-3 text-center" style="background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.35); color: #93c5fd;">
                <div class="d-flex align-items-center justify-content-center gap-2">
                  <div class="spinner-grow spinner-grow-sm text-info" role="status"></div>
                  <span class="fw-bold" id="statusBoxText">Menunggu Pembayaran Masuk...</span>
                </div>
                <div class="small text-muted mt-1" style="color: #cbd5e1 !important; font-size: 11.5px;">
                  Sistem otomatis mendeteksi transaksi & langsung mengirimkan kode aktivasi ke WA Anda.
                </div>
              </div>

              <div class="small text-start p-3 rounded-3 mb-3" style="background: rgba(0, 0, 0, 0.45); border: 1px solid rgba(255,255,255,0.08); color: #e2e8f0;">
                <div class="fw-bold text-light mb-2"><i class="bi bi-info-circle text-primary me-1"></i> Cara Pembayaran:</div>
                <div class="step-item mb-1">
                  <span class="step-num">1</span>
                  <span>Buka aplikasi m-Banking (BCA, Mandiri, BRI, BNI) atau e-Wallet (GoPay, OVO, DANA, ShopeePay, LinkAja).</span>
                </div>
                <div class="step-item mb-1">
                  <span class="step-num">2</span>
                  <span>Pilih menu <strong>Scan QRIS</strong> dan arahkan kamera ke QR Code di atas.</span>
                </div>
                <div class="step-item mb-0">
                  <span class="step-num">3</span>
                  <span><strong>PENTING:</strong> Pastikan nominal transfer sama persis sesuai angka di atas agar sistem otomatis mengenali transaksi Anda.</span>
                </div>
              </div>

              <!-- TOMBOL KONFIRMASI MANUAL (JIKA DIBUTUHKAN) -->
              <button type="button" id="btnConfirm" class="btn btn-outline-success btn-sm w-100 rounded-3 py-2 fw-bold" onclick="submitDonationManual()">
                <i class="bi bi-check2-circle me-1"></i> Konfirmasi Manual (Jika Pembayaran Belum Terdeteksi)
              </button>
            </div>
          </div>
        </div>

        <!-- PLACEHOLDER SEBELUM DONASI (HIGH CONTRAST & CLEAR) -->
        <div id="activationPlaceholder" class="activation-card" style="background: rgba(15, 23, 42, 0.75); border: 1.5px dashed rgba(99, 102, 241, 0.45); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);">
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge" style="background: rgba(99, 102, 241, 0.25); color: #c7d2fe; border: 1px solid rgba(99, 102, 241, 0.5); font-weight: 800; font-size: 12px; padding: 5px 10px;">
              <i class="bi bi-lock-fill me-1"></i> KODE AKTIVASI SIDEBAR
            </span>
            <span class="fw-bold" style="color: #f8fafc; font-size: 14px;">
              Status: <span style="color: #fbbf24; font-weight: 800;" id="statusText">Menunggu Donasi Masuk</span>
            </span>
          </div>
          <p style="color: #e2e8f0; font-size: 13.5px; line-height: 1.6; margin: 0;">
            <i class="bi bi-info-circle text-info me-1"></i> Kode aktivasi sidebar akan <strong style="color: #38bdf8;">otomatis dikirimkan ke nomor WhatsApp Anda</strong> dan <strong style="color: #fde047;">ditampilkan di kotak ini</strong> begitu transaksi pembayaran donasi terdeteksi masuk oleh sistem.
          </p>
        </div>

        <!-- ACTIVATION CODE CARD (MUNCUL HANYA SETELAH DONASI BERHASIL) -->
        <div id="activationCard" class="activation-card" style="display: none;">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
            <div class="d-flex align-items-center gap-2">
              <span class="badge bg-warning text-dark fw-bold px-2 py-1"><i class="bi bi-key-fill"></i> KODE AKTIVASI</span>
              <span class="fw-bold text-light">Kode Buka Kunci Sidebar Anda:</span>
            </div>
            <a href="/admin/sidebar-settings" target="_blank" class="btn btn-outline-warning btn-sm rounded-pill px-3 fw-bold">
              <i class="bi bi-box-arrow-up-right me-1"></i> Buka Pengaturan Sidebar
            </a>
          </div>
          <p class="small text-muted mb-2">
            Gunakan kode aktivasi di bawah ini untuk membuka menu-menu yang terkunci di sidebar Admin Panel:
          </p>
          <div class="code-box">
            <span class="code-text" id="activationCode">donasidulu</span>
            <button type="button" class="btn btn-warning btn-sm fw-bold px-3 py-2 rounded-3" onclick="copyActivationCode()">
              <i class="bi bi-copy me-1"></i> Salin Kode
            </button>
          </div>
          <div class="small text-muted">
            <i class="bi bi-check2-circle text-success me-1"></i> Masukkan kode <strong>donasidulu</strong> pada kolom <em>Password Aktivasi</em> di menu <strong>Pengaturan Sidebar</strong>, lalu ubah status menu menjadi <strong>Tampil</strong>.
          </div>
        </div>
      </div>
    </div>

    <!-- FOOTER -->
    <div class="footer-text">
      &copy; <%= new Date().getFullYear() %> • <%= settings.company_header || 'Billing RTRW & RADIUS' %> • Terima kasih atas setiap dukungan dan kebaikan Anda.
      <div class="mt-1">
        <a href="/admin" class="text-secondary text-decoration-none me-3"><i class="bi bi-speedometer2"></i> Admin Panel</a>
        <a href="/customer" class="text-secondary text-decoration-none"><i class="bi bi-person"></i> Portal Pelanggan</a>
      </div>
    </div>
  </div>

  <!-- SUCCESS MODAL -->
  <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content" style="background:#0f172a;border:1px solid rgba(148,163,184,0.25);border-radius:20px;color:#f8fafc">
        <div class="modal-body text-center p-4">
          <div style="width:68px;height:68px;background:rgba(16,185,129,0.18);color:#10b981;border-radius:50%;display:grid;place-items:center;font-size:32px;margin:0 auto 16px">
            <i class="bi bi-heart-fill text-danger"></i>
          </div>
          <h4 class="fw-bold mb-2">Terima Kasih Banyak!</h4>
          <p class="text-muted small mb-3" id="modalMsg">
            Transaksi donasi Anda telah berhasil diverifikasi oleh sistem.
          </p>

          <div class="p-3 rounded-3 mb-3 text-start" style="background:rgba(245,158,11,0.1);border:1px dashed #f59e0b">
            <div class="small fw-bold text-warning mb-1"><i class="bi bi-key-fill me-1"></i> Kode Aktivasi Sidebar Anda:</div>
            <div class="d-flex align-items-center justify-content-between">
              <span class="fs-4 fw-bold font-monospace text-light" id="modalCode">donasidulu</span>
              <button class="btn btn-warning btn-sm fw-bold px-3" onclick="copyActivationCode()">
                <i class="bi bi-copy"></i> Salin
              </button>
            </div>
          </div>

          <div class="d-grid gap-2">
            <a href="/admin/sidebar-settings" target="_blank" class="btn btn-action-primary">
              <i class="bi bi-layout-sidebar-inset me-1"></i> Ke Pengaturan Sidebar Admin
            </a>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Tutup</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    let currentAmount = 50000;
    let currentOrderId = null;
    let pollInterval = null;
    let isPaid = false;

    function selectPreset(amt) {
      document.getElementById('inputAmount').value = amt;
      document.querySelectorAll('.preset-btn').forEach(btn => {
        btn.classList.remove('active');
        if (btn.textContent.trim() === amt.toLocaleString('id-ID')) {
          btn.classList.add('active');
        }
      });
      generateQris();
    }

    function onAmountChange() {
      const val = parseInt(document.getElementById('inputAmount').value, 10);
      if (val && val >= 1000) {
        document.querySelectorAll('.preset-btn').forEach(btn => btn.classList.remove('active'));
        generateQris();
      }
    }

    async function generateQris() {
      if (isPaid) return;
      const amt = parseInt(document.getElementById('inputAmount').value, 10) || 50000;
      const phone = document.getElementById('inputPhone').value.trim() || '081947215703';
      const name = document.getElementById('inputName').value.trim() || 'Hamba Allah';
      const notes = document.getElementById('inputNotes').value.trim();

      try {
        const res = await fetch('/donasi/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, phone, amount: amt, notes })
        });

        const data = await res.json();
        if (data.success && data.orderId) {
          currentOrderId = data.orderId;
          currentAmount = data.amountUnique || amt;

          document.getElementById('displayAmount').textContent = 'Rp ' + currentAmount.toLocaleString('id-ID');
          
          if (data.uniqueCode) {
            document.getElementById('uniqueBadgeContainer').style.display = 'block';
            document.getElementById('uniqueBadge').textContent = 'Kode Unik: +' + data.uniqueCode;
          }

          const img = document.getElementById('qrImage');
          img.src = (data.qrisUrl || ('/qris/static.jpg?amount=' + currentAmount)) + '&t=' + Date.now();

          startPolling(currentOrderId);
        } else {
          fallbackGenerate(amt);
        }
      } catch (err) {
        console.warn('Fallback dynamic QR:', err);
        fallbackGenerate(amt);
      }
    }

    function fallbackGenerate(amt) {
      currentAmount = Math.max(1000, amt);
      document.getElementById('displayAmount').textContent = 'Rp ' + currentAmount.toLocaleString('id-ID');
      const img = document.getElementById('qrImage');
      img.src = '/qris/static.jpg?amount=' + currentAmount + '&t=' + Date.now();
    }

    function startPolling(orderId) {
      if (pollInterval) clearInterval(pollInterval);
      if (!orderId) return;

      pollInterval = setInterval(async () => {
        if (isPaid) {
          clearInterval(pollInterval);
          return;
        }

        try {
          const res = await fetch('/donasi/status/' + orderId);
          if (!res.ok) return;
          const data = await res.json();

          if (data.success && data.status === 'paid') {
            isPaid = true;
            clearInterval(pollInterval);
            onPaymentDetected(data);
          }
        } catch (e) {
          // ignore network poll errors
        }
      }, 2500);
    }

    function onPaymentDetected(data) {
      const code = data.activationCode || 'donasidulu';
      if (document.getElementById('activationCode')) document.getElementById('activationCode').textContent = code;
      if (document.getElementById('modalCode')) document.getElementById('modalCode').textContent = code;

      // Update status box
      const statusBox = document.getElementById('paymentStatusBox');
      if (statusBox) {
        statusBox.style.background = 'rgba(16, 185, 129, 0.2)';
        statusBox.style.borderColor = 'rgba(16, 185, 129, 0.5)';
        statusBox.style.color = '#34d399';
        statusBox.innerHTML = '<div class="d-flex align-items-center justify-content-center gap-2"><i class="bi bi-check-circle-fill fs-5"></i><span class="fw-bold fs-6">PEMBAYARAN DONASI SUKSES DITERIMA!</span></div><div class="small mt-1" style="color:#a7f3d0 !important;">Kode aktivasi telah dikirim ke WA Anda dan ditampilkan di bawah ini.</div>';
      }

      const placeholder = document.getElementById('activationPlaceholder');
      if (placeholder) placeholder.style.display = 'none';

      const card = document.getElementById('activationCard');
      if (card) {
        card.style.display = 'block';
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      document.getElementById('modalMsg').innerHTML = 
        'Alhamdulillah, donasi dari <strong>' + (data.donorName || 'Sahabat') + '</strong> sebesar <strong>Rp ' + Number(currentAmount).toLocaleString('id-ID') + '</strong> telah berhasil diverifikasi oleh sistem.<br>' +
        '<span class="text-success fw-bold"><i class="bi bi-whatsapp"></i> Notifikasi & kode aktivasi telah dikirim ke nomor WhatsApp Anda!</span>';
      
      const modal = new bootstrap.Modal(document.getElementById('successModal'));
      modal.show();
    }

    function handleQrError() {
      const img = document.getElementById('qrImage');
      img.src = '/qris/static.jpg?t=' + Date.now();
    }

    async function copyNominal() {
      try {
        await navigator.clipboard.writeText(String(currentAmount));
        alert('Nominal Rp ' + currentAmount.toLocaleString('id-ID') + ' berhasil disalin!');
      } catch (e) {
        const ta = document.createElement('textarea');
        ta.value = String(currentAmount);
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        alert('Nominal Rp ' + currentAmount.toLocaleString('id-ID') + ' berhasil disalin!');
      }
    }

    async function copyActivationCode() {
      const code = document.getElementById('activationCode').textContent.trim() || 'donasidulu';
      try {
        await navigator.clipboard.writeText(code);
        alert('Kode aktivasi "' + code + '" berhasil disalin!');
      } catch (e) {
        const ta = document.createElement('textarea');
        ta.value = code;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        alert('Kode aktivasi "' + code + '" berhasil disalin!');
      }
    }

    function downloadQr() {
      const img = document.getElementById('qrImage');
      const a = document.createElement('a');
      a.href = img.src;
      a.download = 'QRIS-Donasi-Rp' + currentAmount + '.jpg';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }

    async function submitDonationManual() {
      const phone = document.getElementById('inputPhone').value.trim();
      const name = document.getElementById('inputName').value.trim() || 'Hamba Allah';
      const notes = document.getElementById('inputNotes').value.trim();

      if (!phone || phone.length < 8) {
        alert('Silakan masukkan nomor WhatsApp yang valid untuk pengiriman kode aktivasi!');
        document.getElementById('inputPhone').focus();
        return;
      }

      const btn = document.getElementById('btnConfirm');
      const origText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Memverifikasi & Mengirim WA...';

      try {
        const res = await fetch('/donasi/confirm', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ orderId: currentOrderId, name, phone, amount: currentAmount, notes })
        });

        const data = await res.json();
        btn.disabled = false;
        btn.innerHTML = origText;

        if (data.success) {
          isPaid = true;
          if (pollInterval) clearInterval(pollInterval);
          onPaymentDetected(data);
        } else {
          alert('Info: ' + (data.message || 'Gagal memproses donasi.'));
        }
      } catch (err) {
        btn.disabled = false;
        btn.innerHTML = origText;
        console.error(err);
        alert('Terjadi kesalahan saat memproses donasi: ' + err.message);
      }
    }

    // Generate initial order on load
    document.addEventListener('DOMContentLoaded', () => {
      generateQris();
    });
  </script>
</body>
</html>
