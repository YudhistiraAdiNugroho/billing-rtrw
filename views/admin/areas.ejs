<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Manajemen Area | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<%- include('partials/sidebar', { activePage: 'areas', company }) %>

<div class="mw">
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-geo-alt"></i>
      <span>Manajemen Area / Wilayah</span>
    </div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <button class="btn btn-p btn-sm" onclick="openModal('addAreaModal')"><i class="bi bi-plus-lg"></i> Tambah Area Baru</button>
    </div>
  </div>

  <div class="page">
    <% if (msg) { %>
      <div class="alert alert-<%= msg.type==='error'?'d':'s' %>"><%= msg.text %></div>
    <% } %>

    <div class="card">
      <div class="card-hd">
        <h6><i class="bi bi-geo-alt-fill"></i> Daftar Master Area / Wilayah (<%= areas.length %>)</h6>
      </div>
      <div class="hint" style="padding:12px 16px 0 16px;font-size:12px;color:var(--muted)">
        Area digunakan untuk mengelompokkan lokasi pelanggan dan wilayah tugas kolektor. Kolektor yang memiliki area tugas tertentu hanya akan mengelola pelanggan di area tersebut.
      </div>
      <div class="tbl-wrap" style="padding-top:12px">
        <table class="dtbl">
          <thead>
            <tr>
              <th>#</th>
              <th>Nama Area / Wilayah</th>
              <th>Keterangan / Deskripsi</th>
              <th>Jumlah Pelanggan</th>
              <th>Jumlah Kolektor</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (!areas || areas.length === 0) { %>
              <tr><td colspan="6" class="text-center text-muted" style="padding:24px">Belum ada data area. Klik "Tambah Area Baru" untuk membuat area.</td></tr>
            <% } else { %>
              <% areas.forEach((a, idx) => { %>
                <tr>
                  <td><%= idx + 1 %></td>
                  <td>
                    <strong style="color:var(--text);font-size:14px"><i class="bi bi-geo-alt text-primary me-1"></i><%= a.name %></strong>
                  </td>
                  <td><span class="text-muted"><%= a.description || '-' %></span></td>
                  <td>
                    <span class="badge bs" style="font-size:12px"><i class="bi bi-people me-1"></i><%= a.customer_count || 0 %> Pelanggan</span>
                  </td>
                  <td>
                    <span class="badge bm" style="font-size:12px"><i class="bi bi-person-badge me-1"></i><%= a.collector_count || 0 %> Kolektor</span>
                  </td>
                  <td>
                    <div class="d-flex gap-2">
                      <button class="btn btn-g btn-icon btn-sm" onclick='editArea(<%- JSON.stringify(a) %>)' title="Edit Area"><i class="bi bi-pencil"></i></button>
                      <form action="/admin/areas/<%= a.id %>/delete" method="POST" onsubmit="return confirm('Hapus area &quot;<%= a.name %>&quot;?')">
                        <button type="submit" class="btn btn-d btn-icon btn-sm" title="Hapus Area"><i class="bi bi-trash"></i></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal Tambah Area -->
<div class="mo" id="addAreaModal">
  <div class="mb">
    <form action="/admin/areas" method="POST">
      <div class="mh"><span class="mt"><i class="bi bi-geo-alt-fill"></i> Tambah Area Baru</span><button type="button" class="mc" onclick="closeModal('addAreaModal')">&times;</button></div>
      <div class="mbody">
        <div class="fg">
          <label class="fl">Nama Area / Wilayah *</label>
          <input type="text" name="name" class="fc" placeholder="Contoh: Kelurahan Sukamaju, Blok C1-C10" required>
        </div>
        <div class="fg">
          <label class="fl">Keterangan / Catatan (Opsional)</label>
          <textarea name="description" class="fc" rows="3" placeholder="Contoh: Wilayah jangkauan ODP-01 s/d ODP-05"></textarea>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('addAreaModal')">Batal</button>
        <button type="submit" class="btn btn-p"><i class="bi bi-check-lg"></i> Simpan Area</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Edit Area -->
<div class="mo" id="editAreaModal">
  <div class="mb">
    <form id="editAreaForm" method="POST">
      <div class="mh"><span class="mt"><i class="bi bi-pencil-square"></i> Edit Data Area</span><button type="button" class="mc" onclick="closeModal('editAreaModal')">&times;</button></div>
      <div class="mbody">
        <div class="fg">
          <label class="fl">Nama Area / Wilayah *</label>
          <input type="text" name="name" id="e-area-name" class="fc" required>
        </div>
        <div class="fg">
          <label class="fl">Keterangan / Catatan (Opsional)</label>
          <textarea name="description" id="e-area-desc" class="fc" rows="3"></textarea>
        </div>
        <div class="hint" style="font-size:11px;color:var(--muted)">
          <i class="bi bi-info-circle"></i> Mengubah nama area akan otomatis memperbarui nama area pada semua pelanggan dan kolektor terkait.
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('editAreaModal')">Batal</button>
        <button type="submit" class="btn btn-p"><i class="bi bi-check-lg"></i> Simpan Perubahan</button>
      </div>
    </form>
  </div>
</div>

<script>
function openModal(id){document.getElementById(id).classList.add('show')}
function closeModal(id){document.getElementById(id).classList.remove('show')}

function editArea(a){
  document.getElementById('editAreaForm').action = '/admin/areas/' + a.id + '/update';
  document.getElementById('e-area-name').value = a.name || '';
  document.getElementById('e-area-desc').value = a.description || '';
  openModal('editAreaModal');
}
</script>
</body>
</html>
